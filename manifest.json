{
  "manifest_version": 3,
  "name": "OrgTree",
  "version": "1.0",
  "description": "조직도로 수신인 이메일 자동 삽입",
  "icons": {
    "16": "icons/icon_16.png",
    "48": "icons/icon_48.png",
    "128": "icons/icon_128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "windows",
    "tabs",
    "identity"
  ],
  "host_permissions": [
    "https://*.google.com/*",
    "https://mail.google.com/*",
    "http://localhost:8090/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content.js"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": "icons/icon_48.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/icon_ex.svg", "src/popup/popup.html"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "oauth2": {
    "client_id": "123584925681-5gdd590s9qp9evsu68j42jeou0of42ku.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.compose",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://localhost:8090/"
  }
}
